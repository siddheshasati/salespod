# -----------------------------------------------------------------------------
# Python caches, test output, and local environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

.venv/
venv/
env/
ENV/
*.egg-info/
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# Secrets, credentials, keys, and confidential local material
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

.secrets/
secrets/
**/secrets/
private/
**/private/
confidential/
**/confidential/
sensitive/
**/sensitive/

credentials.json
credentials.yaml
credentials.yml
credentials.toml
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/credentials.toml
service-account*.json
client_secret*.json
token.json
tokens.json

*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks

# -----------------------------------------------------------------------------
# Local databases, generated fixtures, exports, and backups
# -----------------------------------------------------------------------------
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
data/generated/
scripts/data/

# Keep the committed deterministic evaluation manifest visible.
!data/ground_truth.json
!data/.gitkeep

# -----------------------------------------------------------------------------
# Node.js and frontend artifacts
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Build, temporary, log, and editor files
# -----------------------------------------------------------------------------
build/
*.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo

.idea/
*.iml
.vscode/*.local.json
.vscode/*.local.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
